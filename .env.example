# Copy to .env for Docker Compose. Never commit your real .env file.
# Node.js API + website
PORT=5000
NODE_ENV=production
SERVE_FRONTEND=true
TRUST_PROXY=0

# MongoDB Atlas URI or private MongoDB connection string (required)
MONGO_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/jamia_raza?retryWrites=true&w=majority

# Use a unique random secret of at least 32 characters.
JWT_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=1d

# For a single-origin Docker deployment, this can be http://localhost:5000.
# For Render, replace with the exact public website origin, e.g. https://your-service.onrender.com
CLIENT_URL=http://localhost:5000

# Optional absolute public origin for canonical/OG metadata; if blank, request origin is used.
SITE_URL=

# Admin account is created by running `npm run create-admin` inside backend.
ADMIN_NAME=Jamia Website Administrator
ADMIN_EMAIL=replace-with-a-real-admin-email@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS

# Optional: host port exposed by Docker Compose. Defaults to 5000.
HOST_PORT=5000

# Optional absolute path for media on a persistent mounted disk; blank uses backend/uploads/media.
MEDIA_UPLOAD_DIR=

# Optional Cloudinary storage. Set all three values to enable cloud image delivery.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
